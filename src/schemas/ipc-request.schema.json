{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "androidlink://schemas/ipc-request.schema.json",
  "title": "AndroidLink IPC Request v1",
  "type": "object",
  "required": ["protocolVersion", "requestId", "method", "params", "auth"],
  "properties": {
    "protocolVersion": {"const": 1},
    "requestId": {"type": "string", "minLength": 8, "maxLength": 128},
    "method": {"type": "string", "minLength": 1, "maxLength": 64},
    "params": {"type": "object"},
    "auth": {"type": "string", "minLength": 64, "maxLength": 64}
  },
  "additionalProperties": false
}
